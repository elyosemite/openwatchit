            <div class="t-warn">⚠  4 backends queried · 25 events · 0 backend errors</div>
            <span class="t-gap"></span>
            <div><span class="t-prompt">›</span>&nbsp;<span class="t-cursor"></span></div>
          </div>

          <!-- ── METRICS ── -->
          <div class="t-pane" id="t-metrics">
            <div><span class="t-prompt">›</span>&nbsp;<span class="t-cmd">owit metrics</span><span class="t-filter"> service=api</span><span class="t-flag"> --last</span> <span class="t-val">30m</span><span class="t-flag"> --step</span> <span class="t-val">2m</span></div>
            <span class="t-sep"></span>
            <div class="t-row-metric t-header"><span>SOURCE</span><span>TIME</span><span>METRIC</span><span>VALUE</span><span>LABELS</span></div>
            <div class="t-row-metric"><span class="t-src-1">prometheus</span><span class="t-time">14:30:00</span><span class="t-mname">http_request_duration_p99</span><span class="t-mval">142ms</span><span class="t-labels">service=api env=prod</span></div>
            <div class="t-row-metric"><span class="t-src-1">prometheus</span><span class="t-time">14:30:00</span><span class="t-mname">http_request_duration_p50</span><span class="t-mval">18ms</span><span class="t-labels">service=api env=prod</span></div>
