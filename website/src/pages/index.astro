---
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const features = [
  {
    num: '01',
    title: 'One command, every backend',
    description:
      'Fan-out to Loki, DataDog, Prometheus, CloudWatch, and more in parallel. One ordered result, every time.',
  },
  {
    num: '02',
    title: 'Plugin architecture',
    description:
      'Every vendor is a standalone gRPC plugin. Write yours in Go, Rust, Python — anything with gRPC support.',
  },
  {
    num: '03',
    title: 'No silent failures',
    description:
      'If a backend is unreachable you get an explicit warning alongside partial results — never silent data loss.',
  },
  {
    num: '04',
    title: 'Secure by default',
    description:
      'Credentials are always environment variable references. Plaintext secrets in config are rejected at startup.',
  },
];

const vendors = [
  { name: 'Grafana Loki',        signal: 'Logs',                  version: 'v0.5' },
  { name: 'Prometheus',          signal: 'Metrics',               version: 'v0.5' },
  { name: 'Grafana Tempo',       signal: 'Traces',                version: 'TBD' },
  { name: 'Jaeger',              signal: 'Traces',                version: 'TBD' },
  { name: 'DataDog',             signal: 'Logs, Metrics, Traces', version: 'TBD' },
  { name: 'AWS CloudWatch',      signal: 'Logs, Metrics',         version: 'TBD' },
  { name: 'Azure AppInsights',   signal: 'Logs, Metrics, Traces', version: 'TBD' },
  { name: 'Elasticsearch',       signal: 'Logs',                  version: 'TBD' },
];
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OpenWatchIt — One Query Language for All Your Observability Backends</title>
  <meta name="description" content="Query logs, metrics, traces, and profiles across every observability vendor with a single command." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Fira+Code:wght@400;500&family=Lora:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>

<!-- Nav -->
<nav>
  <div class="container nav-inner">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">ow</span>
      OpenWatchIt
    </a>
    <div class="nav-links">
      <a href={`${base}/getting-started/introduction/`}>Documentation</a>
      <a href={`${base}/changelog/`}>Changelog</a>
      <a href="https://github.com/elyosemite/openwatchit" class="nav-cta" target="_blank">GitHub</a>
    </div>
  </div>
</nav>

<!-- Hero -->
<section class="hero">
  <div class="container">
    <h1>
      One query language for<br />
      <em>all your observability</em> backends
    </h1>
    <p class="hero-sub">
      Query logs, metrics, traces, and profiles across Loki, DataDog, Prometheus, CloudWatch and more — with a single command.
    </p>
    <div class="hero-actions">
      <a href={`${base}/getting-started/introduction/`} class="btn-primary">Get started →</a>
      <a href="https://github.com/elyosemite/openwatchit" class="btn-secondary" target="_blank">View on GitHub</a>
    </div>

    <!-- Terminal mockup -->
    <div class="terminal-wrap">

      <div class="signal-select" role="tablist" aria-label="Signal type">
        <button class="signal-card active" data-pane="t-logs" role="tab" aria-selected="true" aria-controls="t-logs" aria-label="Show Logs demo">
          <span class="signal-card-dot signal-dot-logs" aria-hidden="true"></span>
          <span class="signal-card-label">Logs</span>
          <span class="signal-card-desc">loki · datadog · appinsights · cloudwatch</span>
        </button>
        <button class="signal-card" data-pane="t-metrics" role="tab" aria-selected="false" aria-controls="t-metrics" aria-label="Show Metrics demo">
          <span class="signal-card-dot signal-dot-metrics" aria-hidden="true"></span>
          <span class="signal-card-label">Metrics</span>
          <span class="signal-card-desc">prometheus · datadog · cloudwatch · azmonitor</span>
        </button>
        <button class="signal-card" data-pane="t-traces" role="tab" aria-selected="false" aria-controls="t-traces" aria-label="Show Traces demo">
          <span class="signal-card-dot signal-dot-traces" aria-hidden="true"></span>
          <span class="signal-card-label">Traces</span>
          <span class="signal-card-desc">tempo · jaeger · datadog · zipkin</span>
        </button>
      </div>

      <div class="terminal">
        <div class="terminal-bar" aria-hidden="true">
          <span class="dot dot-r"></span>
          <span class="dot dot-y"></span>
          <span class="dot dot-g"></span>
          <span class="terminal-title">owit</span>
        </div>
        <div class="terminal-body">

          <!-- ── LOGS ── -->
          <div class="t-pane active" id="t-logs">
            <div><span class="t-prompt">›</span>&nbsp;<span class="t-cmd">owit logs</span><span class="t-filter"> level=error service=api</span><span class="t-flag"> --last</span> <span class="t-val">1h</span><span class="t-flag"> --limit</span> <span class="t-val">25</span></div>
            <span class="t-sep"></span>
            <div class="t-row-log t-header"><span>SOURCE</span><span>TIME</span><span>LEVEL</span><span>SERVICE</span><span>TRACE-ID</span><span>MESSAGE</span></div>
            <div class="t-row-log"><span class="t-src-1">loki</span><span class="t-time">14:32:01</span><span class="t-level">error</span><span class="t-svc">api-gw</span><span class="t-tid">a3f9e12b</span><span class="t-msg">upstream timeout: payment-svc (3042ms)</span></div>
            <div class="t-row-log"><span class="t-src-2">datadog</span><span class="t-time">14:32:01</span><span class="t-level">error</span><span class="t-svc">payment</span><span class="t-tid">a3f9e12b</span><span class="t-msg">stripe: connection reset by peer</span></div>
            <div class="t-row-log"><span class="t-src-3">appinsights</span><span class="t-time">14:32:03</span><span class="t-level">error</span><span class="t-svc">api-gw</span><span class="t-tid">a3f9e12b</span><span class="t-msg">retry payment-svc: attempt 2/3</span></div>
            <div class="t-row-log"><span class="t-src-4">cloudwatch</span><span class="t-time">14:32:05</span><span class="t-level">error</span><span class="t-svc">payment</span><span class="t-tid">a3f9e12b</span><span class="t-msg">stripe webhook delivery failed: 503</span></div>
            <div class="t-row-log"><span class="t-src-1">loki</span><span class="t-time">14:33:11</span><span class="t-level">error</span><span class="t-svc">auth</span><span class="t-tid">b7c1d24e</span><span class="t-msg">jwt: signing key not found in JWKS</span></div>
            <div class="t-row-log"><span class="t-src-2">datadog</span><span class="t-time">14:33:13</span><span class="t-level">error</span><span class="t-svc">auth</span><span class="t-tid">b7c1d24e</span><span class="t-msg">oidc provider returned 502 Bad Gateway</span></div>
            <div class="t-row-log"><span class="t-src-3">appinsights</span><span class="t-time">14:33:14</span><span class="t-level">error</span><span class="t-svc">api-gw</span><span class="t-tid">b7c1d24e</span><span class="t-msg">401 upstream: auth-svc unavailable</span></div>
            <div class="t-row-log"><span class="t-src-4">cloudwatch</span><span class="t-time">14:33:15</span><span class="t-level">error</span><span class="t-svc">auth</span><span class="t-tid">b7c1d24e</span><span class="t-msg">dependency health check failed</span></div>
            <div class="t-row-log"><span class="t-src-1">loki</span><span class="t-time">14:38:44</span><span class="t-level">error</span><span class="t-svc">inventory</span><span class="t-tid">c0a5f33d</span><span class="t-msg">deadlock detected on orders table</span></div>
            <div class="t-row-log"><span class="t-src-2">datadog</span><span class="t-time">14:38:45</span><span class="t-level">error</span><span class="t-svc">inventory</span><span class="t-tid">c0a5f33d</span><span class="t-msg">postgres: deadlock, transaction aborted</span></div>
            <div class="t-row-log"><span class="t-src-3">appinsights</span><span class="t-time">14:38:46</span><span class="t-level">error</span><span class="t-svc">api-gw</span><span class="t-tid">c0a5f33d</span><span class="t-msg">500 inventory-svc: internal server error</span></div>
            <div class="t-row-log"><span class="t-src-4">cloudwatch</span><span class="t-time">14:38:47</span><span class="t-level">error</span><span class="t-svc">inventory</span><span class="t-tid">c0a5f33d</span><span class="t-msg">tx rolled back after 3 retries</span></div>
            <div class="t-row-log"><span class="t-src-1">loki</span><span class="t-time">14:42:09</span><span class="t-level">error</span><span class="t-svc">checkout</span><span class="t-tid">d1b8e71f</span><span class="t-msg">inventory hold expired: order aborted</span></div>
            <div class="t-row-log"><span class="t-src-2">datadog</span><span class="t-time">14:42:10</span><span class="t-level">error</span><span class="t-svc">checkout</span><span class="t-tid">d1b8e71f</span><span class="t-msg">saga: compensating transaction started</span></div>
            <div class="t-row-log"><span class="t-src-3">appinsights</span><span class="t-time">14:42:11</span><span class="t-level">error</span><span class="t-svc">checkout</span><span class="t-tid">d1b8e71f</span><span class="t-msg">saga rollback: payment already captured</span></div>
            <div class="t-row-log"><span class="t-src-4">cloudwatch</span><span class="t-time">14:42:13</span><span class="t-level">error</span><span class="t-svc">checkout</span><span class="t-tid">d1b8e71f</span><span class="t-msg">order.failed enqueued to DLQ</span></div>
            <div class="t-row-log"><span class="t-src-1">loki</span><span class="t-time">14:51:22</span><span class="t-level">error</span><span class="t-svc">notifier</span><span class="t-tid">e2c9a80a</span><span class="t-msg">SMTP rejected: 550 address rejected</span></div>
