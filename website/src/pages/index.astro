            <div class="t-row-log"><span class="t-src-3">appinsights</span><span class="t-time">14:51:24</span><span class="t-level">error</span><span class="t-svc">api-gw</span><span class="t-tid">e2c9a80a</span><span class="t-msg">notification skipped: quota hit</span></div>
