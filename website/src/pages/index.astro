<!-- Features -->
<section class="section">
  <div class="container">
    <p class="section-label">Why OpenWatchIt</p>
    <h2 class="section-title">Built for the seams between tools</h2>
    <p class="section-sub">The individual tools are excellent. The problem is having to navigate between them.</p>
    <div class="features-grid">
      {features.map(f => (
        <div class="feature-card">
