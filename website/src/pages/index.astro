    <script>
      document.querySelectorAll('.signal-card').forEach(function(card) {
        card.addEventListener('click', function() {
          document.querySelectorAll('.signal-card').forEach(function(c) {
            c.classList.remove('active');
            c.setAttribute('aria-selected', 'false');
          });
          document.querySelectorAll('.t-pane').forEach(function(p) { p.classList.remove('active'); });
          card.classList.add('active');
          card.setAttribute('aria-selected', 'true');
          var pane = document.getElementById(card.getAttribute('data-pane'));
          if (pane) pane.classList.add('active');
        });
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
        });
      });
    </script>
