            <div class="t-row-log"><span class="t-src-2">datadog</span><span class="t-time">14:57:39</span><span class="t-level">error</span><span class="t-svc">search</span><span class="t-tid">f3d0b91c</span><span class="t-msg">query timeout after 5000ms</span></div>
